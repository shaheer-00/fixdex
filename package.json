{
  "name": "fixdex",
  "version": "0.4.1",
  "description": "Claude Code's local error/fix memory — hooks + skill + MCP + web UI",
  "keywords": [
    "claude-code",
    "claude",
    "anthropic",
    "mcp",
    "model-context-protocol",
    "ai",
    "ai-agent",
    "llm",
    "error-memory",
    "fix-memory",
    "debugging",
    "developer-tools",
    "sqlite",
    "offline",
    "local-first",
    "productivity",
    "knowledge-base",
    "code-assistant"
  ],
  "author": "shaheer-00",
  "license": "MIT",
  "homepage": "https://github.com/shaheer-00/fixdex#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shaheer-00/fixdex.git"
  },
  "bugs": {
    "url": "https://github.com/shaheer-00/fixdex/issues"
  },
  "bin": {
    "fixdex": "dist/cli.js",
    "fixdex-mcp": "dist/mcp.js",
    "fixdex-ui": "dist/ui.js"
  },
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./version": "./dist/version.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc && tsc -p tsconfig.test.json && node scripts/check-version.cjs",
    "prepack": "npm run build",
    "start": "node dist/cli.js",
    "mcp": "node dist/mcp.js",
    "ui": "node dist/ui.js",
    "test": "node --test dist-tests/tests/*.test.js",
    "seed": "node dist/seed.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3": "^9.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.10",
    "@types/node": "^20.12.0",
    "tsx": "^4.23.15",
    "typescript": "^5.4.0"
  }
}
